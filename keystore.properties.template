# Copy this file to `keystore.properties` and fill in the real values.
# `keystore.properties` is gitignored and must NEVER be committed.
#
# Generate a keystore (one-time):
#   keytool -genkey -v \
#     -keystore inkleaf-release.keystore \
#     -alias inkleaf \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then create keystore.properties next to settings.gradle.kts with:

storeFile=/absolute/path/to/inkleaf-release.keystore
storePassword=CHANGEME
keyAlias=inkleaf
keyPassword=CHANGEME
