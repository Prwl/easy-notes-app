<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme (used after splash dismisses) -->
    <style name="Theme.Inkleaf" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme -->
    <style name="Theme.Inkleaf.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF6B35</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#FF6B35</item>
        <item name="postSplashScreenTheme">@style/Theme.Inkleaf</item>
    </style>
</resources>
