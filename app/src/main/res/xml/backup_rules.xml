<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 (API < 31) auto-backup rules.
  - Notes themselves live in the Room SQLite DB, which is intentionally NOT
    backed up (keeps note content on-device only — better privacy).
  - PIN hashes live in DataStore. They are also excluded so that a restored
    install doesn't end up with PIN hashes for notes that no longer exist.
-->
<full-backup-content>
    <exclude domain="database" path="inkleaf.db" />
    <exclude domain="database" path="inkleaf.db-journal" />
    <exclude domain="database" path="inkleaf.db-wal" />
    <exclude domain="database" path="inkleaf.db-shm" />
    <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    <exclude domain="file" path="drawings/" />
</full-backup-content>
